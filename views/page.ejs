<%- include('partials/head') %>
<section class="custom-page-hero">
<div>
<p class="eyebrow">
<%= item.eyebrow||brand.site_name %>
</p>
<h1>
<%= item.title %>
</h1>
<p>
<%= item.hero_text||item.description||'' %>
</p>
</div>
</section>
<main class="custom-page-main">
<section class="custom-page-content">
<% if(item.featured_image){ %>
<img class="page-image" src="<%= urlOrEmpty(item.featured_image) %>" alt="<%= item.title %>">
<% } %>
<%- cleanHtml(item.content||'') %>
<% if(item.route==='services'){ const related=projects.filter(p=>p.service_id===item.id); if(related.length){ %>
<h2>Related projects</h2>
<%- include('partials/cards',{items:related}) %>
<% } } %>
</section>
<section class="project-cta">
<div>
<p class="eyebrow">LET'S BUILD</p>
<h2>
<%= item.cta_title||'Ready to get started?' %>
</h2>
<p>
<%= item.cta_text||'Tell us about your project.' %>
</p>
</div>
<a class="btn primary" href="<%= urlOrEmpty(item.cta_url)||'/#contact' %>">
<%= item.cta_label||'Request a Quote' %>
</a>
</section>
</main>
<%- include('partials/footer') %>
