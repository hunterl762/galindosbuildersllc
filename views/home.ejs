<%- include('partials/head') %>
<main>
<% sections.forEach(section=>{ switch(section.section_key){ case 'hero': %>
<section class="hero">
<div class="hero-shade">
</div>
<div class="hero-content">
<p class="eyebrow">
<%= home.hero_eyebrow %>
</p>
<h1>
<%= home.hero_title %>
</h1>
<p>
<%= home.hero_text %>
</p>
<div class="actions">
<a class="btn primary" href="/projects">Explore Our Work</a>
<a class="btn ghost" href="/#contact">Request a Quote</a>
</div>
</div>
</section>
<% break;case 'about': %>
<section class="intro" id="about">
<div>
<p class="eyebrow dark">
<%= brand.site_name %>
</p>
<h2>
<%= home.about_title %>
</h2>
</div>
<div>
<p>
<%= home.about_text %>
</p>
<a class="text-link" href="/#services">WHAT WE DO →</a>
</div>
</section>
<% break;case 'values': %>
<section class="values">
<% [['Integrity','Clear communication and accountability from start to finish.'],['Craftsmanship','Precise work, durable results and attention to the details that matter.'],['Safety','A jobsite culture centered on planning, awareness and responsible execution.'],['Partnership','We work closely with owners, contractors and trades to keep projects moving.']].forEach(([title,text],i)=>{ %>
<article>
<span>0<%= i+1 %>
</span>
<h3>
<%= title %>
</h3>
<p>
<%= text %>
</p>
</article>
<% }); %>
</section>
<% break;case 'services': %>
<section class="services" id="services">
<div class="section-heading">
<p class="eyebrow dark">OUR CAPABILITIES</p>
<h2>Built for demanding projects.</h2>
</div>
<div class="service-grid">
<% services.forEach((s,i)=>{ %>
<article>
<b>
<%= String(i+1).padStart(2,'0') %>
</b>
<h3>
<a href="/services/<%= encodeURIComponent(s.slug) %>">
<%= s.name %>
</a>
</h3>
<p>
<%= s.description %>
</p>
</article>
<% }); %>
</div>
</section>
<% break;case 'projects': const featured=projects.filter(p=>p.featured); %>
<section class="projects-section">
<div class="section-heading row">
<div>
<p class="eyebrow dark">SELECTED WORK</p>
<h2>Featured Projects</h2>
</div>
<a class="text-link" href="/projects">VIEW ALL PROJECTS →</a>
</div>
<%- include('partials/cards',{items:(featured.length?featured:projects).slice(0,6)}) %>
<% if(!projects.length){ %>
<div class="empty-projects">
<h3>Our work</h3>
<p>Project photos and case studies are coming soon.</p>
</div>
<% } %>
</section>
<% break;case 'contact': %>
<section class="contact" id="contact">
<p class="eyebrow">LET'S BUILD</p>
<h2>
<%= home.contact_title %>
</h2>
<p>
<%= home.contact_text %>
</p>
<% if(sent){ %>
<div class="quote-success" role="status">Thank you. Your quote request has been submitted.</div>
<% } %>
<form class="quote-form" action="/quote" method="post">
<input type="hidden" name="csrf" value="<%= csrf %>">
<input name="name" required maxlength="255" aria-label="Name" placeholder="Name">
<input type="email" name="email" required maxlength="255" aria-label="Email" placeholder="Email">
<input name="phone" maxlength="80" aria-label="Phone" placeholder="Phone">
<input name="project_type" maxlength="160" aria-label="Project type" placeholder="Project type">
<input name="location" maxlength="255" aria-label="Project location" placeholder="Project location">
<textarea name="message" required minlength="10" maxlength="10000" rows="5" aria-label="Project details" placeholder="Tell us about your project">
</textarea>
<button class="btn primary">Request a Quote</button>
</form>
</section>
<% break; } }); %>
</main>
<%- include('partials/footer') %>
