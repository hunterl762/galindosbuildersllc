<div class="project-grid">
<% items.forEach(p=>{ %>
<a class="project-card" data-category="<%= p.category||'' %>" href="/project/<%= encodeURIComponent(p.slug) %>">
<div class="project-image">
<% if(p.featured_image){ %>
<img src="<%= p.featured_image %>" alt="<%= p.images[0]?.alt_text||p.images[0]?.media_alt||p.name %>" loading="lazy">
<% } %>
</div>
<div>
<small>
<%= p.category||'PROJECT' %>
</small>
<h3>
<%= p.name %>
</h3>
<p>
<%= p.location %>
</p>
</div>
</a>
<% }); %>
</div>
