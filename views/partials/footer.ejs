<footer>
<div class="brand">
<% if(brand.header_logo_url){ %>
<img class="site-brand-logo" src="<%= brand.header_logo_url %>" alt="<%= brand.site_name %> logo">
<% }else{ %>
<span class="brand-mark">GB</span>
<% } %>
<%- include('brand-name') %>
</div>
<p>
<%= brand.footer_text %>
</p>
<p>© <%= new Date().getFullYear() %> <%= brand.site_name %>.</p>
</footer>
</body>
</html>
