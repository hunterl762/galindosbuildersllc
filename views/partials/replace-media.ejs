<% if(m.url.startsWith('/uploads/media/')){ %>
<form class="image-form" method="post" action="/admin/media/<%= m.id %>/replace" enctype="multipart/form-data" data-upload>
<input type="hidden" name="csrf" value="<%= csrf %>">
<label>Replace image (same format)<input type="file" name="image" required accept="<%= m.mime_type %>">
</label>
<button>Replace Everywhere</button>
<p role="status" data-upload-status>
</p>
</form>
<% } %>
