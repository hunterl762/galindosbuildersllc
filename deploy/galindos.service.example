[Unit]
Description=Galindos Builders Node CMS
After=network.target
[Service]
Type=simple
User=galindos
WorkingDirectory=/srv/galindosbuildersllc
EnvironmentFile=/srv/galindosbuildersllc/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
