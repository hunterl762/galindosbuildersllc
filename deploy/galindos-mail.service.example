[Unit]
Description=Galindos Builders email outbox worker
After=network.target
[Service]
Type=simple
User=galindos
WorkingDirectory=/srv/galindosbuildersllc
EnvironmentFile=/srv/galindosbuildersllc/.env
ExecStart=/usr/bin/node scripts/mail-worker.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
