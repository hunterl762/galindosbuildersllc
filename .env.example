# PHP CMS configuration. Copy to .env on the server; do not upload local credentials.
SITE_URL=http://127.0.0.1:8000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=galindosbuilders
DB_USER=galindos
DB_PASS=
# Required for browser install/update and initial administrator creation.
# Generate: php -r "echo bin2hex(random_bytes(32));"
SETUP_TOKEN=
# true for HTTPS cPanel hosting; false for local development.
COOKIE_SECURE=false
UPLOAD_DIR=uploads
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
QUOTE_NOTIFY_EMAIL=

# Required for the public quote form; missing configuration fails closed.
# Create a Managed Turnstile widget for the production website hostnames.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact frontend hostnames, comma separated, without scheme, path or port.
# Production must not include localhost or 127.0.0.1.
TURNSTILE_HOSTNAMES=galindosbuildersllc.com,www.galindosbuildersllc.com
# Optional: only current, verified Cloudflare proxy CIDRs when the origin sees
# Cloudflare as REMOTE_ADDR. Leave empty when the web server restores visitor IPs.
# Never use 0.0.0.0/0 or ::/0. Do not trust arbitrary forwarding headers.
TURNSTILE_TRUSTED_PROXY_CIDRS=
