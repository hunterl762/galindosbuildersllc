# PHP CMS configuration. Copy to .env on the server; do not upload local credentials.
SITE_URL=http://127.0.0.1:8000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=galindosbuilders
DB_USER=galindos
DB_PASS=
# Required for browser install/update and initial administrator creation.
# Generate: php -r "echo bin2hex(random_bytes(32));"
SETUP_TOKEN=
# true for HTTPS cPanel hosting; false for local development.
COOKIE_SECURE=false
UPLOAD_DIR=uploads
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
QUOTE_NOTIFY_EMAIL=
